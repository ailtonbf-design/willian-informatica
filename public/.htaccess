# ============================================================
#  William Informática - Hostgator / Apache Configuration
# ============================================================

# Desabilita listagem de diretórios
Options -Indexes

# Ativa o motor de reescrita
RewriteEngine On

# 1. Redireciona URLs sem extensão para arquivos .html se eles existirem
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/]+)/?$ /$1.html [L]

# 2. Serve arquivos e diretórios existentes diretamente
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# 3. Qualquer outra rota desconhecida vai para index.html (fallback SPA)
RewriteRule ^ index.html [L]

# ------------------------------------------------------------------
#  Cache de longa duração para assets versionados pelo Vite
# ------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On

    # Assets com hash no nome: 1 ano
    <FilesMatch "\.(js|css|woff|woff2|ttf|otf|eot|svg|png|jpg|jpeg|gif|webp|ico|avif)$">
        ExpiresDefault "access plus 1 year"
        Header set Cache-Control "max-age=31536000, immutable"
    </FilesMatch>

    # HTMLs: sem cache (garantir versão atualizada sempre)
    <FilesMatch "\.html$">
        ExpiresDefault "access plus 0 seconds"
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>

# ------------------------------------------------------------------
#  Tipos MIME corretos
# ------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType application/javascript .js .mjs
    AddType text/css .css
    AddType image/webp .webp
    AddType image/avif .avif
    AddType font/woff2 .woff2
    AddType font/woff .woff
</IfModule>

# ------------------------------------------------------------------
#  Compressão GZIP para melhorar performance
# ------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2
</IfModule>

# ------------------------------------------------------------------
#  Charset padrão UTF-8
# ------------------------------------------------------------------
AddDefaultCharset UTF-8

# ------------------------------------------------------------------
#  Segurança básica: esconde versão do servidor e info de tecnologia
# ------------------------------------------------------------------
ServerSignature Off
